# ============================================================
# 邓俊辉《数据结构(C++语言版)》配套源码 — .gitignore
# 适用 CMake / C++ 项目
# ============================================================

# ---------- CMake 构建输出 ----------
build/
_executable/

# ---------- IDE / 编辑器 ----------
.vs/
.vscode/
.idea/
*.code-workspace
*.vcxproj.user

# ---------- 编译中间产物 ----------
*.obj
*.pch
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.i
*.ii
*.sbr

# ---------- 临时 / 备份文件 ----------
*~
*.bak
*.orig
*.swp
*.tmp
*.log

# ---------- 操作系统 ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- 备注 ----------
# _input/ 与 _output/ 为测试数据 / 运行结果，按需保留，默认不忽略。
# 如运行结果无需入库，可取消下面注释：
# _output/
